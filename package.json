{
  "name": "djintech",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=testing jest --config ./apps/api/test/jest-e2e.json --runInBand",
    "test:unit": "cross-env NODE_ENV=testing jest --config ./apps/api/test/jest-unit.json --runInBand",
    "test:files:e2e": "cross-env NODE_ENV=testing jest --config ./apps/files/test/jest-e2e.json --runInBand",
    "test:files:unit": "cross-env NODE_ENV=testing jest --config ./apps/files/test/jest-unit.json --runInBand",
    "test:payments:unit": "cross-env NODE_ENV=testing jest --config ./apps/payments/test/jest-unit.json --runInBand",
    "build:api": "nest build api",
    "start:api": "cross-env NODE_ENV=production node dist/apps/api/main.js",
    "start:dev:api": "cross-env NODE_ENV=development nest start api --watch",
    "start:api:debug": "cross-env NODE_ENV=development nest start api --debug --watch",
    "build:files": "nest build files",
    "start:files": "cross-env NODE_ENV=production node dist/apps/files/main.js",
    "start:dev:files": "cross-env NODE_ENV=development nest start files --watch",
    "start:files:debug": "cross-env NODE_ENV=development nest start files --debug --watch",
    "build:payments": "nest build payments",
    "start:payments": "cross-env NODE_ENV=production node dist/apps/payments/main.js",
    "start:dev:payments": "cross-env NODE_ENV=development nest start payments --watch",
    "start:payments:debug": "cross-env NODE_ENV=development nest start payments --debug --watch",
    "prisma:api:generate": "prisma generate --config=apps/api/prisma/prisma.config.ts",
    "prisma:api:generate:dev": "cross-env NODE_ENV=development dotenv -e .env.development.local -- prisma generate --config=apps/api/prisma/prisma.config.ts",
    "prisma:api:migrate:dev": "cross-env NODE_ENV=development dotenv -e .env.development.local -- prisma migrate dev --config=apps/api/prisma/prisma.config.ts",
    "prisma:api:migrate:deploy:test": "cross-env NODE_ENV=testing  dotenv -e .env.testing -- prisma migrate deploy --config=apps/api/prisma/prisma.config.ts",
    "prisma:api:migrate:create": "cross-env NODE_ENV=development dotenv -e .env.development.local -- prisma migrate dev --create-only --config=apps/api/prisma/prisma.config.ts",
    "prisma:payments:migrate:dev": "cross-env NODE_ENV=development dotenv -e .env.development.local -- prisma migrate dev --config=apps/payments/prisma/prisma.config.ts",
    "prisma:payments:generate:dev": "cross-env NODE_ENV=development dotenv -e .env.development.local -- prisma generate --config=apps/payments/prisma/prisma.config.ts",
    "prisma:payments:migrate:deploy:test": "cross-env NODE_ENV=testing dotenv -e .env.testing -- prisma migrate deploy --config=apps/payments/prisma/prisma.config.ts",
    "prisma:payments:migrate:create": "cross-env NODE_ENV=development dotenv -e .env.development.local -- prisma migrate dev --create-only --config=apps/payments/prisma/prisma.config.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/s3-request-presigner": "^3.1012.0",
    "@nestjs-modules/mailer": "^2.3.6",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.12",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.26",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.3.0",
    "@types/stripe": "^8.0.417",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "date-fns": "^4.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "ms": "^2.1.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.3.0",
    "serve": "^14.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}