{
  "moduleFileExtensions": [ "js", "json", "ts" ],
  "testTimeout": 5000,
  "rootDir": "../",
  "preset": "ts-jest",
  "testEnvironment": "node",
  "testRegex": ".unit.test.ts$",
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/src/$1",
    "^@modules/(.*)$": "<rootDir>/src/modules/$1",
    "^@libs/(.*)$": "<rootDir>/../../libs/$1",
    "^@files/(.*)$": "<rootDir>/src/$1"
  }
}
