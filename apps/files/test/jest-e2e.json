{
  "moduleFileExtensions": ["js", "json", "ts"],
  "testTimeout": 100000,
  "maxWorkers": 1,
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/tsconfig.app.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/src/$1",
    "^@modules/(.*)$": "<rootDir>/src/modules/$1",
    "^@libs/(.*)$": "<rootDir>/../../libs/$1",
    "^@files/(.*)$": "<rootDir>/src/$1"
  }
}
