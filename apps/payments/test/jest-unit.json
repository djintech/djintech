{
  "moduleFileExtensions": ["js", "json", "ts"],
  "testTimeout": 5000,
  "rootDir": "../",
  "preset": "ts-jest",
  "testEnvironment": "node",
  "testRegex": ".unit.test.ts$|.integration.test.ts$",
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/src/$1",
    "^@modules/(.*)$": "<rootDir>/src/modules/$1",
    "^@core/(.*)$": "<rootDir>/src/core/$1",
    "^@libs/(.*)$": "<rootDir>/../../libs/$1",
    "^apps/payments/(.*)$": "<rootDir>/$1",
    "^node_modules/(.*)$": "<rootDir>/../../node_modules/$1"
  }
}
