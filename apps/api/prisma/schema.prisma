generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  username     String    @unique
  passwordHash String? 
  isConfirmed  Boolean   @default(false)

  isBanned     Boolean   @default(false)
  banReason    String?
  banDate      DateTime?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  emailConfirmation EmailConfirmation?
  passwordRecovery  PasswordRecovery?
  Device            Device[]
  policyAgreements  UserPolicyAgreement[]
  providers         UserProvider[]
  posts             Post[]
  profile           Profile?
  notification      Notification[]
  comments          Comment[]
  postLikes         PostLike[]
  commentLikes      CommentLike[]

  followers UserFollow[] @relation("Follower")
  following UserFollow[] @relation("Following")

  messagesSent Message[] @relation("MessageOwner")
  messagesReceived Message[] @relation("MessageReceiver")

  @@map("users")
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  // Кто подписался
  follower User @relation( "Follower", fields: [followerId], references: [id], onDelete: Cascade )
  // На кого подписались
  following User @relation( "Following", fields: [followingId], references: [id], onDelete: Cascade )

  // Один пользователь не может подписаться на одного и того же пользователя больше одного раза
  @@unique([followerId, followingId])

  @@index([followerId])
  @@index([followingId])

  @@map("userFollows")
}

model EmailConfirmation {
  id               Int       @id @default(autoincrement())
  confirmationCode String
  expirationDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emailConfirmations")
}

model PasswordRecovery {
  id                     Int      @id @default(autoincrement())
  recoveryCode           String
  recoveryCodeExpireDate DateTime
  alreadyChangePassword  Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  userId                 Int      @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passwordRecoveries")
}

model Device {
  id           Int       @id @default(autoincrement())
  userId       Int
  deviceName   String
  deviceId     String    @unique
  ip           String
  lastActiveAt DateTime
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

enum PolicyType {
  tos
  privacy
}

model Policies {
  id        Int        @id @default(autoincrement())
  type      PolicyType
  content   String
  version   Int
  updatedAt DateTime   @updatedAt
  createdAt DateTime @default(now())

  policyAgreements  UserPolicyAgreement[]
 
  @@map("policies")
}

model UserPolicyAgreement {
  id        Int        @id @default(autoincrement())
  userId    Int
  policyId  Int
  acceptedAt DateTime  @default(now())

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy Policies @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([userId, policyId])
  @@map("userPolicyAgreements")
}

enum ProviderType {
  google
  github
}

model UserProvider {
  id            Int        @id @default(autoincrement())
  userId        Int
  provider      ProviderType
  providerId    String
  providerEmail String?
  createdAt     DateTime @default(now())

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerId])
  @@index([userId])
  @@map("userProviders")
} 

model Post {
  id           Int @id @default(autoincrement())
  userId       Int
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  postImages   PostImage[]
  comments     Comment[]
  postLikes    PostLike[]
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("posts")
}

model PostImage {
  id              Int @id @default(autoincrement())
  postId          Int
  key             String @unique
  mimeType        String
  size            Int
  position        Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  isDeletedFromS3 Boolean  @default(false)

  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([postId, position])
  @@index([postId])
  @@map("postImages")
}

enum LikePostStatus {
  NONE
  LIKE
  DISLIKE
}

model PostLike {
  id        Int             @id @default(autoincrement())
  status    LikePostStatus  @default(NONE)
  postId    Int
  userId    Int
  createdAt DateTime        @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("postLikes")
}

model Comment {
  id        Int       @id @default(autoincrement())
  postId    Int
  userId    Int
  parentId  Int?
  content   String    @db.VarChar(300)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  post Post @relation( fields: [postId], references: [id], onDelete: Cascade )
  user User @relation( fields: [userId], references: [id], onDelete: Cascade )
  parent Comment? @relation( "CommentReplies", fields: [parentId], references: [id], onDelete: SetNull )

  replies Comment[] @relation("CommentReplies")

  commentLikes CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("comments")
}

enum LikeCommentStatus {
  NONE
  LIKE
  DISLIKE
}

model CommentLike {
  id        Int               @id @default(autoincrement())
  status    LikeCommentStatus @default(NONE)
  commentId Int
  userId    Int
  createdAt DateTime          @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("commentLikes")
}

enum AccountType {
  Personal
  Business
}

model Profile {
  id           Int @id @default(autoincrement())
  userId       Int @unique
  firstName    String?
  lastName     String?
  dateOfBirth  DateTime?
  aboutMe      String?
  country      String?
  city         String?
  accountType  AccountType @default(Personal)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  
  avatar       Avatar?
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Avatar {
  id              Int @id @default(autoincrement())
  profileId       Int @unique
  key             String @unique
  mimeType        String
  size            Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  isDeletedFromS3 Boolean  @default(false)

  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("avatars")
}

enum NotificationType {
  SUBSCRIPTION_ACTIVATED
  PAYMENT_REMINDER
  SUBSCRIPTION_EXPIRES_7_DAYS
  SUBSCRIPTION_EXPIRES_1_DAY
}

model Notification {
  id         Int              @id @default(autoincrement())

  userId     Int
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       NotificationType
  message    String           @db.VarChar(500)

  isRead     Boolean          @default(false)

  notifyAt   DateTime

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  @@index([userId, notifyAt])
  @@index([userId, isRead])
  @@index([deletedAt])

  @@map("notifications")
}

enum MessageStatus {
  SENT
  RECEIVED
  READ
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
}

model Message {
  id          Int           @id @default(autoincrement())
  ownerId     Int
  receiverId  Int
  messageText String?
  status      MessageStatus @default(SENT)
  messageType MessageType   @default(TEXT)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User @relation("MessageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([receiverId])
  @@index([ownerId, receiverId])
  @@map("messages")
}
