generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  username     String    @unique
  passwordHash String? 
  isConfirmed  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  emailConfirmation EmailConfirmation?
  passwordRecovery  PasswordRecovery?
  Device            Device[]
  policyAgreements  UserPolicyAgreement[]
  providers         UserProvider[]
  posts             Post[]

  @@map("users")
}

model EmailConfirmation {
  id               Int       @id @default(autoincrement())
  confirmationCode String
  expirationDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emailConfirmations")
}

model PasswordRecovery {
  id                     Int      @id @default(autoincrement())
  recoveryCode           String
  recoveryCodeExpireDate DateTime
  alreadyChangePassword  Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  userId                 Int      @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passwordRecoveries")
}

model Device {
  id           Int       @id @default(autoincrement())
  userId       Int
  deviceName   String
  deviceId     String    @unique
  ip           String
  lastActiveAt DateTime
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

enum PolicyType {
  tos
  privacy
}

model Policies {
  id        Int        @id @default(autoincrement())
  type      PolicyType
  content   String
  version   Int
  updatedAt DateTime   @updatedAt
  createdAt DateTime @default(now())

  policyAgreements  UserPolicyAgreement[]
 
  @@map("policies")
}

model UserPolicyAgreement {
  id        Int        @id @default(autoincrement())
  userId    Int
  policyId  Int
  acceptedAt DateTime  @default(now())

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy Policies @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([userId, policyId])
  @@map("userPolicyAgreements")
}

enum ProviderType {
  google
  github
}

model UserProvider {
  id            Int        @id @default(autoincrement())
  userId        Int
  provider      ProviderType
  providerId    String
  providerEmail String?
  createdAt     DateTime @default(now())

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerId])
  @@index([userId])
  @@map("userProviders")
} 

model Post {
  id           Int @id @default(autoincrement())
  userId       Int
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  postImages   PostImage[]
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("posts")
}

model PostImage {
  id          Int @id @default(autoincrement())
  postId      Int
  key         String @unique
  mimeType    String
  size        Int
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@unique([postId, position])
  @@index([postId])
  @@map("postImages")
}
