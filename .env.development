REFRESH_TOKEN_SECRET=secretOrKey
ACCESS_TOKEN_EXPIRE_IN=15m #10s #
REFRESH_TOKEN_EXPIRE_IN=20m  #20s #

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

#GOOGLE OUATH 2.0 
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback