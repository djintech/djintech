PORT=5001

FILE_SERVICE_HOST=127.0.0.1
FILE_SERVICE_PORT=4177

IS_SWAGGER_ENABLED=true

CORS_ORIGIN=http://localhost:5001,http://localhost:3000

#Crypto Service
COST_FACTOR=2

SEND_INTERNAL_SERVER_ERROR_DETAILS=true

INCLUDE_TESTING_MODULE=true

#APPLICATION/DOMAIN SETTINGS
